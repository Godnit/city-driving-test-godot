# Add direct PDF functions before restoreAppAfterHtmlPrint.
marker2='''    private void restoreAppAfterHtmlPrint() {'''
helpers=r'''    private void createPdfAtUri(Uri uri) {
        destroyPrintWebView();
        try {
            pendingPdfDescriptor = getContentResolver().openFileDescriptor(uri, "w");
            if (pendingPdfDescriptor == null) throw new IllegalStateException("No PDF descriptor");

            printWebView = new WebView(this);
            WebSettings ps = printWebView.getSettings();
            ps.setJavaScriptEnabled(true);
            ps.setDomStorageEnabled(true);
            ps.setDefaultTextEncodingName("UTF-8");
            printWebView.setBackgroundColor(Color.WHITE);
            printWebView.setAlpha(0.01f);
            printWebView.setTranslationX(-10000f);
            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(
                    FrameLayout.LayoutParams.MATCH_PARENT,
                    FrameLayout.LayoutParams.MATCH_PARENT
            );
            rootLayout.addView(printWebView, 0, lp);

            printWebView.setWebViewClient(new WebViewClient() {
                private boolean started = false;
                @Override
                public void onPageFinished(WebView view, String url) {
                    if (started) return;
                    started = true;
                    view.postDelayed(() -> writeAttachedWebViewPdf(view), 550);
                }
            });
            printWebView.loadDataWithBaseURL(
                    "https://halaqa.local/direct-pdf-v310/",
                    pendingPdfHtml,
                    "text/html",
                    "UTF-8",
                    null
            );
        } catch (Exception ex) {
            finishDirectPdf(false, "تعذر تجهيز ملف PDF");
        }
    }

    private void writeAttachedWebViewPdf(WebView source) {
        try {
            PrintDocumentAdapter adapter = source.createPrintDocumentAdapter(pendingPdfName);
            PrintAttributes.MediaSize media = pendingPdfLandscape
                    ? PrintAttributes.MediaSize.ISO_A4.asLandscape()
                    : PrintAttributes.MediaSize.ISO_A4.asPortrait();
            PrintAttributes attributes = new PrintAttributes.Builder()
                    .setMediaSize(media)
                    .setColorMode(PrintAttributes.COLOR_MODE_COLOR)
                    .setMinMargins(PrintAttributes.Margins.NO_MARGINS)
                    .setResolution(new PrintAttributes.Resolution("halaqa_pdf", "Halaqa PDF", 300, 300))
                    .build();
            CancellationSignal signal = new CancellationSignal();
            adapter.onLayout(null, attributes, signal, new PrintDocumentAdapter.LayoutResultCallback() {
                @Override
                public void onLayoutFinished(PrintDocumentInfo info, boolean changed) {
                    adapter.onWrite(new PageRange[]{PageRange.ALL_PAGES}, pendingPdfDescriptor, signal,
                            new PrintDocumentAdapter.WriteResultCallback() {
                                @Override
                                public void onWriteFinished(PageRange[] pages) {
                                    adapter.onFinish();
                                    finishDirectPdf(true, "تم حفظ تقرير PDF");
                                }
                                @Override
                                public void onWriteFailed(CharSequence error) {
                                    adapter.onFinish();
                                    finishDirectPdf(false, "تعذر إنشاء ملف PDF");
                                }
                                @Override
                                public void onWriteCancelled() {
                                    adapter.onFinish();
                                    finishDirectPdf(false, "تم إلغاء إنشاء PDF");
                                }
                            });
                }
                @Override
                public void onLayoutFailed(CharSequence error) {
                    adapter.onFinish();
                    finishDirectPdf(false, "تعذر تنسيق ملف PDF");
                }
                @Override
                public void onLayoutCancelled() {
                    adapter.onFinish();
                    finishDirectPdf(false, "تم إلغاء إنشاء PDF");
                }
            }, null);
        } catch (Exception ex) {
            finishDirectPdf(false, "تعذر إنشاء ملف PDF");
        }
    }

    private void finishDirectPdf(boolean success, String message) {
        try {
            if (pendingPdfDescriptor != null) pendingPdfDescriptor.close();
        } catch (Exception ignored) {}
        pendingPdfDescriptor = null;
        pendingPdfHtml = "";
        if (printWebView != null && rootLayout != null) {
            try { rootLayout.removeView(printWebView); } catch (Exception ignored) {}
        }
        destroyPrintWebView();
        Toast.makeText(this, message, success ? Toast.LENGTH_SHORT : Toast.LENGTH_LONG).show();
    }

