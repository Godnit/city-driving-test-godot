bridge='''        @JavascriptInterface
        public void saveHtmlAsPdf(String fileName, String html, boolean landscape) {
            pendingPdfName = sanitizePdfName(fileName);
            pendingPdfHtml = (html == null || html.trim().isEmpty())
                    ? "<html dir='rtl'><body>لا توجد بيانات للتقرير</body></html>" : html;
            pendingPdfLandscape = landscape;
            runOnUiThread(() -> {
                Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
                intent.addCategory(Intent.CATEGORY_OPENABLE);
                intent.setType("application/pdf");
                intent.putExtra(Intent.EXTRA_TITLE, pendingPdfName);
                try {
                    startActivityForResult(intent, REQUEST_SAVE_PDF);
                } catch (Exception ex) {
                    Toast.makeText(MainActivity.this, "تعذر فتح نافذة حفظ PDF", Toast.LENGTH_LONG).show();
                }
            });
        }

        @JavascriptInterface
        public String appVersion() {
            return "3.1.0";
        }'''
