<small>السور والآيات والتقديرات والحالات والملاحظات والإعادة.</small></button></div></div>
      <div class="fx-step"><div class="fx-step-title">٢. الطلاب</div><div class="fx-options"><button class="fx-option" data-fx-group="scope" data-fx-value="single" onclick="FreshExporter.choose('scope','single')"><b>الطالب الحالي</b><small id="freshCurrentStudent">—</small></button><button class="fx-option" data-fx-group="scope" data-fx-value="all" onclick="FreshExporter.choose('scope','all')"><b>جميع الطلاب</b><small>جدول أفقي منظم يشبه Excel.</small></button></div></div>
      <div class="fx-step"><div class="fx-step-title">٣. الفترة</div><div class="fx-options"><button class="fx-option" data-fx-group="period" data-fx-value="weekly" onclick="FreshExporter.choose('period','weekly')"><b>أسبوعي</b><small>الأسبوع المحدد وحده فقط.</small></button><button class="fx-option" data-fx-group="period" data-fx-value="monthly" onclick="FreshExporter.choose('period','monthly')"><b>شهري</b><small>الأسابيع الأربعة والنتيجة النهائية.</small></button></div><div id="freshWeekStep" style="margin-top:9px"><div id="freshWeekPicker" class="fx-weeks">${WEEK_NAMES.map((n,i)=>`<button class="fx-week" data-week="${i}" onclick="FreshExporter.chooseWeek(${i})">${n}</button>`).join('')}</div></div></div>
      <div class="fx-step"><div class="fx-step-title">٤. القسم</div><div class="fx-options three"><button class="fx-option" data-fx-group="session" data-fx-value="both" onclick="FreshExporter.choose('session','both')"><b>الحفظ والمراجعة</b></button><button class="fx-option" data-fx-group="session" data-fx-value="memorization" onclick="FreshExporter.choose('session','memorization')"><b>الحفظ فقط</b></button><button class="fx-option" data-fx-group="session" data-fx-value="review" onclick="FreshExporter.choose('session','review')"><b>المراجعة فقط</b></button></div></div>
      <div id="freshSelection" class="fx-selection"></div><button class="primary-btn full" onclick="FreshExporter.preview()">إنشاء المعاينة</button></div></div>
      <div id="freshPreviewModal" class="modal fx-modal" onclick="modalBackdrop(event,'freshPreviewModal')"><div class="sheet-modal fx-preview-sheet"><div class="modal-head"><h3>معاينة التقرير النهائية</h3><button class="close-btn" onclick="closeModal('freshPreviewModal')">×</button></div><div class="fx-preview-toolbar"><button class="primary-btn" onclick="FreshExporter.save()">حفظ ملف PDF</button><button class="secondary-btn" onclick="closeModal('freshPreviewModal');openModal('freshExportModal')">تعديل الاختيارات</button><span id="freshPreviewSummary" class="subtle"></span></div><div class="fx-preview-stage"><div id="freshPreviewPaper" class="fx-preview-paper"></div></div></div></div>`);
  }
  window.FreshExporter={open:openFreshExport,choose,chooseWeek,preview,save,build,state:()=>({...fxState}),snapshot:()=>fxSnapshot,setState:s=>{fxState=normalize(s);renderFxControls()}};
  window.openPdfExportModal=openFreshExport;
  window.exportPdf=scope=>{openFreshExport();fxState.scope=scope==='all'?'all':'single';renderFxControls()};
  window.runPdfExport=preview;window.printPreparedReport=save;
  function init(){inject();const b=q('#page-report .page-title .primary-btn');if(b){b.textContent='تصدير PDF';b.onclick=openFreshExport}try{if(sessionStorage.getItem('halaqa_return_after_fx_print'))sessionStorage.removeItem('halaqa_return_after_fx_print')}catch(_){}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
